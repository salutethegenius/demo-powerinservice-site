# Copy to .env.local for local development. Set the same keys in Vercel
# for Production and Preview.

# Resend API key from https://resend.com
RESEND_API_KEY=

# Must be a verified Resend from address, for example:
# Power In Service <hello@powerandcleaning.com>
RESEND_FROM_EMAIL=

# Inbox that should receive quote requests.
# Defaults to hello@powerandservice.com if omitted.
QUOTE_TO_EMAIL=hello@powerandservice.com

# Optional Google Search Console HTML-tag verification content.
GOOGLE_SITE_VERIFICATION=
